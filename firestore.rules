rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid == 'nNoSFWamtZaVT4SPnYP3XxW3Uml1'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isMember() {
      return signedIn()
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function userDoc(uid) { return /databases/$(db)/documents/users/$(uid); }
    function limoDoc(id) { return /databases/$(db)/documents/limoRequests/$(id); }
    function isNum(v) { return v == null || v is number; }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.auth.token.firebase.sign_in_provider == 'password'
            && request.resource.data.keys().hasOnly(['name', 'status', 'created', 'apps', 'lastRead'])
            && request.resource.data.status == 'pending'
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apps', 'lastRead']))
        // Betalen met Limo-punten: alleen samen met het betaalde verzoek (zelfde batch)
        || (signedIn() && request.auth.uid == uid && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'lastPaid'])
            && request.resource.data.lastPaid is string
            && get(limoDoc(request.resource.data.lastPaid)).data.uid == request.auth.uid
            && get(limoDoc(request.resource.data.lastPaid)).data.status == 'payment_requested'
            && get(limoDoc(request.resource.data.lastPaid)).data.price > 0
            && getAfter(limoDoc(request.resource.data.lastPaid)).data.status == 'paid'
            && request.resource.data.points == resource.data.get('points', 0) - get(limoDoc(request.resource.data.lastPaid)).data.price
            && request.resource.data.points >= 0);
      allow delete: if isAdmin();
    }

    match /items/{id} {
      allow read: if isMember() || isAdmin();
      allow create: if (isMember() || isAdmin())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow update: if (isMember() || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done']);
      allow delete: if isMember() || isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAdmin()
        || (isMember() && (resource.data.to == 'all' || resource.data.to == request.auth.uid));
      allow create: if isAdmin()
        || (isMember() && request.resource.data.to == 'nNoSFWamtZaVT4SPnYP3XxW3Uml1'
            && request.resource.data.from == request.auth.uid
            && request.resource.data.keys().hasOnly(['to', 'text', 'from', 'created'])
            && request.resource.data.text is string && request.resource.data.text.size() <= 200);
      allow delete: if isAdmin();
    }

    match /limoRequests/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == get(userDoc(request.auth.uid)).data.name
        && request.resource.data.keys().hasOnly(['uid', 'name', 'type', 'note', 'lat', 'lng', 'acc', 'status', 'created', 'dismissed'])
        && request.resource.data.type in ['taxi', 'service']
        && request.resource.data.status == 'pending'
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && isNum(request.resource.data.lat) && isNum(request.resource.data.lng) && isNum(request.resource.data.acc);
      allow update: if isAdmin()
        || (isMember() && resource.data.uid == request.auth.uid && (
            // Dismiss na geaccepteerd of geweigerd
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissed'])
              && resource.data.status in ['accepted', 'declined'])
            // Betalen: punten gaan er in dezelfde batch van af
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt'])
              && resource.data.status == 'payment_requested'
              && request.resource.data.status == 'paid'
              && getAfter(userDoc(request.auth.uid)).data.get('points', 0) == get(userDoc(request.auth.uid)).data.get('points', 0) - resource.data.price
              && getAfter(userDoc(request.auth.uid)).data.get('points', 0) >= 0)));
      allow delete: if isAdmin();
    }

    // ---------- Gamescroller ----------
    match /scores/{sid} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && sid == request.resource.data.game + '__' + request.auth.uid
        && request.resource.data.keys().hasOnly(['game', 'uid', 'name', 'best', 'updated'])
        && request.resource.data.game is string && request.resource.data.game.size() < 40
        && request.resource.data.best is number && request.resource.data.best >= 0 && request.resource.data.best < 1000000000
        && request.resource.data.name == get(userDoc(request.auth.uid)).data.name;
      allow update: if isMember()
        && request.resource.data.uid == request.auth.uid
        && sid == request.resource.data.game + '__' + request.auth.uid
        && request.resource.data.keys().hasOnly(['game', 'uid', 'name', 'best', 'updated'])
        && request.resource.data.best is number && request.resource.data.best >= resource.data.best && request.resource.data.best < 1000000000
        && request.resource.data.name == get(userDoc(request.auth.uid)).data.name;
    }

    match /gamesaves/{sid} {
      allow read: if isMember() && resource.data.uid == request.auth.uid;
      allow create, update: if isMember()
        && request.resource.data.uid == request.auth.uid
        && sid == request.resource.data.game + '__' + request.auth.uid
        && request.resource.data.keys().hasOnly(['game', 'uid', 'data', 'updated'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 20000;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // ---------- Klusjes ----------
    match /chores/{id} {
      allow read: if isAdmin() || (isMember() && (resource.data.to == 'all' || resource.data.to == request.auth.uid));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isMember() && (resource.data.to == 'all' || resource.data.to == request.auth.uid) && (
            // klaarmelden met bericht/foto
            (resource.data.status == 'open'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneBy', 'doneByName', 'doneAt', 'proofMsg', 'proofPhoto', 'proofAt'])
              && request.resource.data.status == 'review'
              && request.resource.data.doneBy == request.auth.uid
              && (!('proofMsg' in request.resource.data) || request.resource.data.proofMsg.size() <= 300)
              && (!('proofPhoto' in request.resource.data) || request.resource.data.proofPhoto.size() < 450000))
            // eigen bewijs opruimen
            || (resource.data.doneBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proofMsg', 'proofPhoto'])
              && !('proofMsg' in request.resource.data) && !('proofPhoto' in request.resource.data))));
    }

    match /taskstats/{uid} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
    }

    match /milestones/{id} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
    }

    match /milestoneClaims/{cid} {
      allow read: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && cid == request.resource.data.milestone + '__' + request.auth.uid
        && request.resource.data.keys().hasOnly(['milestone', 'uid', 'name', 'title', 'status', 'created'])
        && request.resource.data.status == 'pending'
        && exists(/databases/$(db)/documents/taskstats/$(request.auth.uid))
        && get(/databases/$(db)/documents/taskstats/$(request.auth.uid)).data.total
           >= get(/databases/$(db)/documents/milestones/$(request.resource.data.milestone)).data.need;
      allow update, delete: if isAdmin();
    }

    // ---------- Dagelijkse vraag, Agenda, Gewoontes, Huisdier ----------
    match /dailyq/{day} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
      match /answers/{uid} {
        // Antwoorden van anderen zie je pas nadat je zelf hebt geantwoord
        allow read: if isAdmin()
          || (isMember() && (request.auth.uid == uid
              || exists(/databases/$(db)/documents/dailyq/$(day)/answers/$(request.auth.uid))));
        allow create, update: if isMember() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'created'])
          && request.resource.data.name == get(userDoc(uid)).data.name
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 400;
        allow delete: if isAdmin() || (isMember() && request.auth.uid == uid);
      }
    }

    match /events/{id} {
      allow read: if isMember() || isAdmin();
      allow create: if isMember() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['title', 'date', 'time', 'note', 'repeat', 'color', 'by', 'byName', 'created'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.repeat in ['none', 'weekly', 'yearly']
        && request.resource.data.note is string && request.resource.data.note.size() <= 200;
      allow update: if isAdmin()
        || (isMember() && resource.data.by == request.auth.uid && request.resource.data.by == request.auth.uid
            && request.resource.data.keys().hasOnly(['title', 'date', 'time', 'note', 'repeat', 'color', 'by', 'byName', 'created'])
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.repeat in ['none', 'weekly', 'yearly']);
      allow delete: if isAdmin() || (isMember() && resource.data.by == request.auth.uid);
    }

    match /habits/{uid} {
      allow read, delete: if isMember() && request.auth.uid == uid;
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string && request.resource.data.data.size() < 40000;
    }

    match /pets/{uid} {
      allow read: if isMember() || isAdmin();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string && request.resource.data.data.size() < 20000;
      allow delete: if isMember() && request.auth.uid == uid;
    }

    // Cadeautjes tussen huisdieren (eten, speelgoed, knuffel) en munten van de admin
    match /petgifts/{id} {
      allow read: if isAdmin()
        || (isMember() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid));
      allow create: if (isMember() && request.resource.data.from == request.auth.uid
            && request.resource.data.to != request.auth.uid
            && request.resource.data.keys().hasOnly(['to', 'toName', 'from', 'fromName', 'kind', 'item', 'label', 'created', 'claimed'])
            && request.resource.data.kind in ['food', 'toy', 'hug']
            && request.resource.data.claimed == false
            && request.resource.data.item is string && request.resource.data.item.size() <= 20
            && request.resource.data.label is string && request.resource.data.label.size() <= 40)
        || (isAdmin() && request.resource.data.from == request.auth.uid
            && request.resource.data.keys().hasOnly(['to', 'toName', 'from', 'fromName', 'kind', 'item', 'label', 'created', 'claimed', 'amount'])
            && request.resource.data.claimed == false
            && (request.resource.data.kind != 'coins' || (request.resource.data.amount is int && request.resource.data.amount >= 1 && request.resource.data.amount <= 500)));
      allow update: if isMember() && resource.data.to == request.auth.uid && resource.data.claimed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && request.resource.data.claimed == true;
      allow delete: if isAdmin() || (isMember() && resource.data.to == request.auth.uid);
    }

    // Toestemming van de eigenaar: wie mag mijn huisdier helpen
    match /petperms/{owner} {
      allow read: if isMember() || isAdmin();
      allow create, update: if isMember() && request.auth.uid == owner
        && request.resource.data.keys().hasOnly(['allow', 'updated'])
        && request.resource.data.allow is list && request.resource.data.allow.size() <= 10;
      allow delete: if isMember() && request.auth.uid == owner;
    }

    // Hulp van een vriend (voeren, spelen, wassen...) - alleen met toestemming van de eigenaar
    match /pethelps/{id} {
      allow read: if isAdmin()
        || (isMember() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid));
      allow create: if isMember() && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.keys().hasOnly(['to', 'toName', 'from', 'fromName', 'action', 'detail', 'created', 'applied'])
        && request.resource.data.action in ['feed', 'play', 'wash', 'sleep', 'pet']
        && request.resource.data.applied == false
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 30
        && request.auth.uid in get(/databases/$(db)/documents/petperms/$(request.resource.data.to)).data.allow;
      allow update: if isMember() && resource.data.to == request.auth.uid && resource.data.applied == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applied'])
        && request.resource.data.applied == true;
      allow delete: if isAdmin() || (isMember() && resource.data.to == request.auth.uid);
    }

    // Evenement dat de admin instelt (bijv. dubbele munten)
    match /petevent/{doc} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
    }

    match /config/{doc} {
      allow read, write: if isAdmin();
    }
    match /config/push {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
    }
    match /config/giphy {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- Chat ----------
    match /profiles/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name == get(userDoc(uid)).data.name;
    }

    match /friendships/{pid} {
      allow read: if isMember() && request.auth.uid in resource.data.members;
      allow create: if isMember()
        && pid.split('_').size() == 2
        && request.auth.uid in pid.split('_')
        && request.resource.data.members == pid.split('_')
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.blockedBy == null
        && request.resource.data.keys().hasOnly(['members', 'requester', 'status', 'blockedBy', 'last', 'lastAt', 'lastFrom', 'reads'])
        && exists(/databases/$(db)/documents/profiles/$(pid.split('_')[0]))
        && exists(/databases/$(db)/documents/profiles/$(pid.split('_')[1]));
      allow update: if isMember() && request.auth.uid in resource.data.members && (
          // accepteren of blokkeren door degene die het verzoek kreeg
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'blockedBy'])
            && resource.data.status == 'pending' && resource.data.requester != request.auth.uid
            && ((request.resource.data.status == 'accepted' && request.resource.data.blockedBy == null)
                || (request.resource.data.status == 'blocked' && request.resource.data.blockedBy == request.auth.uid)))
          // een vriend blokkeren
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'blockedBy'])
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'blocked' && request.resource.data.blockedBy == request.auth.uid)
          // deblokkeren (alleen door wie blokkeerde)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'blockedBy'])
            && resource.data.status == 'blocked' && resource.data.blockedBy == request.auth.uid
            && request.resource.data.status == 'accepted' && request.resource.data.blockedBy == null)
          // laatste bericht bijwerken
          || (resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'lastAt', 'lastFrom'])
            && request.resource.data.lastFrom == request.auth.uid)
          // gelezen-markering (alleen je eigen)
          || (resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reads'])
            && request.resource.data.reads.diff(resource.data.reads).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if isMember() && request.auth.uid in resource.data.members
        && (resource.data.status != 'blocked' || resource.data.blockedBy == request.auth.uid);
    }

    match /chats/{pid}/messages/{mid} {
      function chatOk() {
        return isMember() && request.auth.uid in pid.split('_')
          && get(/databases/$(db)/documents/friendships/$(pid)).data.status == 'accepted';
      }
      allow read: if chatOk();
      allow create: if chatOk()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from', 'type', 'text', 'data', 'url', 'parts', 'mime', 'created'])
        && request.resource.data.type in ['text', 'image', 'video', 'gif']
        && (request.resource.data.type != 'text'
            || (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000))
        && (request.resource.data.type != 'image'
            || (request.resource.data.data is string && request.resource.data.data.size() < 900000 && request.resource.data.data.matches('data:image/.*')))
        && (request.resource.data.type != 'gif'
            || (request.resource.data.url is string && request.resource.data.url.matches('https://[a-z0-9]+\\.giphy\\.com/.*')))
        && (request.resource.data.type != 'video'
            || (request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 24));
      allow delete: if chatOk() && resource.data.from == request.auth.uid;

      match /chunks/{n} {
        allow read: if chatOk();
        allow create: if chatOk()
          && request.resource.data.keys().hasOnly(['d', 'by'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.d is string && request.resource.data.d.size() < 700000;
        allow delete: if chatOk() && resource.data.by == request.auth.uid;
      }
    }
  }
}
